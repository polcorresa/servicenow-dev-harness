# DEV instance (your PDI). Use a dedicated integration user, not your own login.
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=claude.agent
SN_PASSWORD=

# PROD instance (read-only). Leave empty to simulate PROD with the PDI.
PROD_INSTANCE=
PROD_USER=
PROD_PASSWORD=

# Optional: override the comma-separated list of config tables the agent may write to.
# SN_WRITE_TABLES=sys_script,sys_script_include
